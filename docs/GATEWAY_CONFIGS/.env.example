# .env.example — کپی به .env و پر کن
# هرگز .env را کامیت نکن! (.gitignore)

LITELLM_MASTER_KEY=sk-litellm-local-CHANGE-ME-32chars-min
LITELLM_SALT_KEY=sk-salt-CHANGE-ME-32chars-min-generate-once

# هر کدام را که داری پر کن:
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-v1-...
MISTRAL_API_KEY=...
SAMBANOVA_API_KEY=sn-...
COHERE_API_KEY=...
NVIDIA_API_KEY=nvapi-...
CLOUDFLARE_API_KEY=...
DATABASE_URL=postgresql://litellm:litellmpassword@db:5432/litellm
REDIS_HOST=redis
REDIS_PASSWORD=redispassword
